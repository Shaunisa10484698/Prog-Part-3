@model RaceDayWeb.ViewModels.LoginViewModel
<h2>Login</h2>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<form asp-action="Login" method="post">
    <div class="mb-3"><label>Email</label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label>Password</label><input asp-for="Password" type="password" class="form-control" /></div>
    <button class="btn btn-primary">Login</button>
    <a asp-action="Register" class="btn btn-link">No account? Register</a>
</form>
